# Choose development locally and production on the VM. This value is logged only.
APP_ENV=development

# Required Discord bot token. Never commit a real token.
DISCORD_TOKEN=your_discord_bot_token

# Optional: when set, slash commands synchronize only to this guild. Use a test
# guild locally; leave empty on production to preserve global synchronization.
GUILD_ID=123456789012345678

# Discord runtime options. Keep these defaults unless a local test requires a change.
DISCORD_COMMAND_PREFIX=!
DISCORD_MESSAGE_CONTENT_INTENT=true
DISCORD_EMBEDS_PER_MESSAGE=10

# Production should keep this true. Set it to false for local Discord UI testing
# to prevent official polling, state initialization, delivery creation, and sends.
ENABLE_ANNOUNCEMENT_PIPELINE=true

# Optional low-frequency Ambient Nikki skill events. This is disabled by default
# and needs at least one approved channel ID. It never reads keywords or sends
# replies to a player's message.
AMBIENT_NIKKI_ENABLED=false
AMBIENT_NIKKI_TRIGGER_RATE=0.03
AMBIENT_NIKKI_SLEEP_TRIGGER_RATE=0.08
AMBIENT_NIKKI_COOLDOWN_MINUTES=30
AMBIENT_NIKKI_CHANNEL_IDS=

# Active official announcement destinations. Values are comma-separated channel IDs.
TW_OFFICIAL_ANNOUNCEMENT_CHANNEL_IDS=111111111111111111
CN_OFFICIAL_ANNOUNCEMENT_CHANNEL_IDS=222222222222222222

# Retained legacy settings. They are not used by the official live poller, but are
# kept for archive-recovery tools and retained code paths.
ANNOUNCEMENT_CHANNEL_IDS=111111111111111111,222222222222222222
TW_ANNOUNCEMENT_CHANNEL_IDS=
QUERY_CHANNEL_IDS=333333333333333333
ADMIN_CHANNEL_IDS=444444444444444444

# Optional administrator allow lists, also comma-separated.
DISCORD_ADMIN_USER_IDS=555555555555555555
DISCORD_ADMIN_ROLE_IDS=666666666666666666
