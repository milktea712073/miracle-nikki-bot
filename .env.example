# Required Discord bot token. Never commit a real token.
DISCORD_TOKEN=your_discord_bot_token

# Comma-separated Discord channel IDs. Use test values only in this example.
ANNOUNCEMENT_CHANNEL_IDS=111111111111111111,222222222222222222
# Legacy Facebook v2 override. Retained only for archive recovery; not live-polled.
TW_ANNOUNCEMENT_CHANNEL_IDS=
# Active official-site destination overrides. Taiwan falls back to the legacy
# Taiwan/default announcement list when unset; China must be configured explicitly.
TW_OFFICIAL_ANNOUNCEMENT_CHANNEL_IDS=
CN_OFFICIAL_ANNOUNCEMENT_CHANNEL_IDS=777777777777777777
QUERY_CHANNEL_IDS=333333333333333333
ADMIN_CHANNEL_IDS=444444444444444444

# Optional administrator allow lists, also comma-separated.
DISCORD_ADMIN_USER_IDS=555555555555555555
DISCORD_ADMIN_ROLE_IDS=666666666666666666
